# Supabase project URL and publishable key. RLS must be enabled for every exposed table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional local UI preview only; code also enforces NODE_ENV=development.
LOOPEC_DEV_BYPASS_AUTH=false
